# gemini-web2api 管理令牌，面板 http://127.0.0.1:8083/admin/ 使用
ADMIN_TOKEN=change-me-admin-token
# 客户端调用 Gemini 服务的 key（sk-gemini-...）
API_KEY=sk-gemini-change-me

# chatgpt2api 客户端鉴权 key
CHATGPT2API_AUTH_KEY=sk-chatgpt-change-me

# DeepSeek WebUI 管理密码（http://127.0.0.1:8090/webui）
DS_ADMIN_PASSWORD=change-me-admin-password
# DeepSeek 客户端 API key（sk-ds-...）
DS_API_KEY=sk-ds-change-me

# Gemini 出口代理；不需要代理时删掉 docker-compose.yml 里的 --proxy 两行
GEMINI_PROXY=http://127.0.0.1:5080

# new-api 网关
NEWAPI_SESSION_SECRET=change-me-random-secret
NEWAPI_ADMIN_PASSWORD=change-me-admin-password
